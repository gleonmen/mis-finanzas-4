# Postgres (local dev via docker compose)
POSTGRES_USER=finanzas
POSTGRES_PASSWORD=finanzas
POSTGRES_DB=finanzas

# Backend connection string (points at the compose `db` service)
DATABASE_URL=postgresql+psycopg://finanzas:finanzas@db:5432/finanzas

# Frontend -> backend base URL (used by the browser)
VITE_API_BASE_URL=http://localhost:8000
